econ_incometop1percent2015 = IncomeInequalityAvgIncomeOfTop1Perc2024,#Data are for tax units (single adults or married couples), referred to in the report as families, and for 2015, unless otherwise indicated. From Economic Policy Institute report published in July 2018.
econ_incomebottom90percent2015 = IncomeInequalityAvgIncomeOfBottom99Perc2024,
econ_ratiotop10percenttobottom90percent2015 = IncomeInequalityTop10PercToBottom90PercRatio2024,
econ_col2022 = CostOfLivingIndex2023, #Cost of living indexes are calculated by first determining a baseline for comparison. When comparing costs across states, the average cost of living in the United States is used as the baseline set at 100. States are then measured against this baseline. For example, a state with a cost of living index of 200 is twice as expensive as the national average. Likewise, living in a state with an index of 50 will cost about half the national average.
econ_corporatetax2023 = CorporateTaxRates2024, #Cannot figure out from where or exactly when, but seems it must be rates that apply in 2023
env_airquality2023 = AirQualityIndex2024, #The Air Quality Index (AQI) is an index calculated for four major air pollutants regulated by the Clean Air Act: ground-level ozone, particle pollution, carbon monoxide, and sulfur dioxide. The AQI runs from zero to 500, with zero representing clean air and 500 being the most hazardous. Values of 100 or below are generally thought of as satisfactory; however, when values are above 100, air quality is considered unhealthy for certain at-risk groups of people and becomes more unsafe as the value increases.
env_avetemp2023 = AverageTemperatureF2024,
env_avehightemp2023 = AverageTemperatureAvgHighF2024,
env_avelowtemp2023 = AverageTemperatureAvgLowF2024,
guns_ownership2017 = GunOwnershipPercentage2024, # Civilians owned an estimated 393,347,000 total firearms in the United States in 2017 (measured against a 2017 population of 326,474,000).
guns_licenses2022 = GunOwnershipLicensesIn2022) %>%
mutate(pop_growth2022to2023 = popgrowthRate2022to2023*100,
pop_growthSince2010 = popgrowthRateSince2010*100) %>%
select(-pop2019, -pop2010, -pop2022, -popgrowthRate2022to2023, -popgrowthRateSince2010, -popareaSquareMiles2023, -popPerSqMile2023)
