head(abortion)
Leip <- read_excel("Leip2020.xlsx")
head(Leip)
Leip <- Leip %>%
select(-vote_electoralBiden2020, -vote_electoralTrump2020)
load("state_polarization.RData", verbose = TRUE)
state_polarization <- state_polarization %>%
filter(year == 2020) %>%
rename(st = state,
democ_DemocraticPolarization2020 = dem_polarization,
democ_RepublicanPolarization2020 = rep_polarization) %>%
select(st, democ_RepublicanPolarization2020, democ_DemocraticPolarization2020)
head(state_polarization)
# Manually add "DC" to the state abbreviation vector from the package datasets with the state.abb function
state.abb <- c(state.abb, "DC")
# Create a new variable 'State' with state names using the state.name function from the package datasets
state_polarization$State <- state.name[match(state_polarization$st, state.abb)]
state_polarization$State <- ifelse(is.na(state_polarization$State), "District of Columbia", state_polarization$State)
state_polarization <- state_polarization %>%
select(-st)
head(state_polarization, n=15)
Everytown <- read_excel("EverytownGuns.xlsx")
head(Everytown)
Everytown <- Everytown %>%
rename(guns_deaths2021 = gun.violence,
guns_lawstrength2023 = gun.law.strength,
guns_concealed2023 = concealed.carry,
guns_shootfirst2023 = no.shoot.first,
guns_background2023 = background.check) %>%
select(State, guns_deaths2021, guns_lawstrength2023, guns_concealed2023, guns_shootfirst2023, guns_background2023)
ballot <- read_excel("Ballotpedia2022PartyControl.xlsx")
head(ballot)
ballot <- ballot %>%
rename(party_governor2022 = GovernorPartyID2022,
party_HouseMajority2022 = HouseMajorityPartyID2022,
party_SenateMajority2022 = SenateMajorityPartyID2022)
head(ballot)
# Merge yale and kff based on the 'State' variable
merged_dataA <- merge(yale, KFF3, by = "State", all = TRUE)  # Using 'all = TRUE' to perform a full outer join
# Merge the result with 'wpr' based on the 'State' variable
merged_dataB <- merge(merged_dataA, WPR, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'wpr' based on the 'State' variable
merged_dataC <- merge(merged_dataB, Grumbach2, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'census' based on the 'State' variable
merged_dataD <- merge(merged_dataC, census, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'votingrequirements' based on the 'st' variable
merged_dataE <- merge(merged_dataD, votingrequirements, by = "st", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'COVI2022' based on the 'st' variable
merged_dataF <- merge(merged_dataE, COVI2022, by = "st", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'COVI2020' based on the 'st' variable
merged_dataG <- merge(merged_dataF, COVI2020, by = "st", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'marijuana' based on the 'State' variable
merged_dataH <- merge(merged_dataG, marijuana, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'abortion' based on the 'st' variable
merged_dataI <- merge(merged_dataH, abortion, by = "st", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'Leip' based on the 'State' variable
merged_dataJ <- merge(merged_dataI, Leip, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'state_polarization' based on the 'State' variable
merged_dataK <- merge(merged_dataJ, state_polarization, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'Everytown' based on the 'State' variable
merged_dataL <- merge(merged_dataK, Everytown, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# Merge the result with 'Everytown' based on the 'State' variable
merged_data <- merge(merged_dataL, ballot, by = "State", all = TRUE)  # Using 'all = TRUE' again for a full outer join
# View the merged data frame
head(merged_data)
# Drop st.x and rename st.y ST
merged_data <- merged_data %>%
select(-st.x) %>%
rename(ST = st.y)
# Arrange columns in alphabetical order
merged_data <- merged_data[, order(names(merged_data))]
# Reorder columns so that 'State' comes first, followed by ST and then evertything else in alphabetical order
merged_data <- merged_data %>%
select(State, ST, order(names(.)))
# Print the data frame to verify the column order
print(merged_data)
write.csv(merged_data, file = "states.data.SP2024.csv", row.names = FALSE)
save(merged_data, file = "states.data.SP2024.RData")
variable_list <- paste(names(merged_data), collapse = ", ")
variable_list
